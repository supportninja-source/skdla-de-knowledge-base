function firstEmptyInputRow_(sheet,startRow,maxRow){const end=Math.min(maxRow,sheet.getMaxRows());const vals=sheet.getRange(startRow,1,end-startRow+1,1).getValues();for(let i=0;i<vals.length;i++)if(vals[i][0]===''||vals[i][0]==null)return startRow+i;sheet.insertRowsAfter(sheet.getMaxRows(),1000);return end+1;}

function doGet() {
  authorize_();
  return HtmlService.createTemplateFromFile('Index')
    .evaluate()
    .setTitle('3Shape → ABS Operations Hub')
    .setXFrameOptionsMode(HtmlService.XFrameOptionsMode.DEFAULT);
}

function include(filename) { return HtmlService.createHtmlOutputFromFile(filename).getContent(); }

function getBootstrap(requestedShiftDate) {
  authorize_();
  const shiftDate = normalizeShiftDate_(requestedShiftDate) || currentOperationalShiftDate_();
  ensureWebSheets_();
  const dashboard = buildDashboard_(shiftDate);
  return {
    appName: '3Shape → ABS Operations Hub', shiftDate,
    shiftCoverage: shiftCoverageLabel_(shiftDate), targetPerHour: HUB.TARGET_PER_HOUR,
    ninjas: HUB.NINJAS, dashboard, productivity: buildProductivity_(shiftDate),
    clearPath: buildClearPath_(shiftDate), hourly: buildHourly_(shiftDate),
    serverTime: Utilities.formatDate(new Date(), HUB.TZ, 'yyyy-MM-dd HH:mm:ss')
  };
}
function getDashboard(shiftDate){authorize_();return buildDashboard_(normalizeShiftDate_(shiftDate));}
function getProductivity(shiftDate){authorize_();return buildProductivity_(normalizeShiftDate_(shiftDate));}
function getClearPath(shiftDate){authorize_();return buildClearPath_(normalizeShiftDate_(shiftDate));}
function getHourly(shiftDate){authorize_();return buildHourly_(normalizeShiftDate_(shiftDate));}
function getReconciliation(shiftDate,statusFilter,limit){authorize_();const key=normalizeShiftDate_(shiftDate);const rows=reconciliationRows_(key);const filter=String(statusFilter||'ALL').toUpperCase();let out=rows;if(filter==='PENDING')out=rows.filter(r=>String(r.reconciliationStatus).includes('PENDING'));if(filter==='COMPLETED')out=rows.filter(r=>r.absDisposition==='Completed');if(filter==='ESCALATED')out=rows.filter(r=>r.absDisposition==='Escalated');if(filter==='ISSUES')out=rows.filter(r=>r.qualityIssues.length);return out.slice(0,Math.min(Number(limit)||1000,5000));}
function getPending(shiftDate,limit){authorize_();return reconciliationRows_(normalizeShiftDate_(shiftDate)).filter(r=>String(r.reconciliationStatus).includes('PENDING')).slice(0,Math.min(Number(limit)||1000,5000));}
function getUnmatched(shiftDate,limit){authorize_();const key=normalizeShiftDate_(shiftDate);const sheet=getSheet_(HUB.SHEETS.UNMATCHED);if(!sheet)return[];const values=readRows_(sheet,13);if(!values.length)return[];const headers=values[0].map(v=>String(v||'').trim());const shiftIdx=findHeaderIndex_(headers,['Shift Date','Operational Shift Date','ABS Operational Shift Date']);const data=values.slice(1).filter(r=>r.some(v=>v!==''&&v!=null));const filtered=shiftIdx>=0?data.filter(r=>dateKey_(r[shiftIdx])===key):data;return filtered.slice(0,Math.min(Number(limit)||1000,5000)).map(r=>rowObject_(headers,r));}
function getHistory(fromDate,toDate){authorize_();return getHistoricalReport(fromDate,toDate,'ALL').rows;}
function getHistoricalReport(fromDate,toDate,ninjaFilter){authorize_();const from=normalizeShiftDate_(fromDate);const to=normalizeShiftDate_(toDate);if(!from||!to)throw new Error('From and To Shift Dates are required.');if(from>to)throw new Error('From Shift Date cannot be after To Shift Date.');const dayCount=Math.round((stripTime_(parseDateKey_(to))-stripTime_(parseDateKey_(from)))/86400000)+1;if(dayCount>120)throw new Error('Historical reports are limited to 120 Shift Dates at a time.');const ninja=canonicalNinja_(ninjaFilter);if(!ninja){const sheet=getSheet_(HUB.SHEETS.RECON);const rows=readRows_(sheet,15);if(!rows.length)return{mode:'TEAM',ninja:'ALL',rows:[]};const map={};rows.slice(1).forEach(r=>{if(!r[0])return;const d=dateKey_(r[14]);if(!d||d<from||d>to)return;if(!map[d])map[d]={shiftDate:d,scraped:0,completed:0,escalated:0,pending:0,reconciled:0};const x=map[d];x.scraped++;const disp=String(r[6]||'').trim();if(disp==='Completed'){x.completed++;x.reconciled++;}else if(disp==='Escalated'){x.escalated++;x.reconciled++;}else x.pending++;});const out=Object.values(map).sort((a,b)=>b.shiftDate.localeCompare(a.shiftDate)).map(x=>({...x,reconciliationRate:x.scraped?round2_(x.reconciled/x.scraped*100):0}));return{mode:'TEAM',ninja:'ALL',rows:out};}const scrapes=scrapeRows_();const outcomes=absOutcomeRows_();const rows=[];const cursor=parseDateKey_(from);const last=parseDateKey_(to);while(stripTime_(cursor)<=stripTime_(last)){const d=Utilities.formatDate(cursor,HUB.TZ,'yyyy-MM-dd');const scraped=scrapes.filter(r=>r.shiftDate===d&&r.scrapedBy===ninja).length;const completed=outcomes.filter(r=>r.operationalShiftDate===d&&r.ninja===ninja&&r.disposition==='Completed').length;const escalated=outcomes.filter(r=>r.operationalShiftDate===d&&r.ninja===ninja&&r.disposition==='Escalated').length;const actual=completed+escalated;const target=productivityTargetForNinja_(d,ninja);rows.push({shiftDate:d,ninja,scraped,completed,escalated,actual,target,attainment:target?round2_(actual/target*100):0});cursor.setDate(cursor.getDate()+1);}return{mode:'NINJA',ninja,rows:rows.sort((a,b)=>b.shiftDate.localeCompare(a.shiftDate))};}

function addScrape(payload){authorize_();if(!payload)throw new Error('Missing scrape payload.');const patient=cleanText_(payload.patientName);const link=cleanText_(payload.sourceLink);const uploadedFileUrl=cleanText_(payload.uploadedFileUrl);const uploadedFileName=cleanText_(payload.uploadedFileName);const ninja=canonicalNinja_(payload.scrapedBy);if(!patient)throw new Error('Patient name is required.');if(!(link||uploadedFileUrl))throw new Error('Paste the source/PDF link or upload a PDF file.');if(!ninja)throw new Error('Scraped By is required.');const duplicate=checkCaseDuplicate({sourceLink:link||uploadedFileUrl,fileName:uploadedFileName,patientName:patient});if(duplicate.strongDuplicate){const best=duplicate.matches[0]||{};throw new Error('DUPLICATE — this case already exists in the tracker'+(best.trackerId?' ('+best.trackerId+')':'')+'. Review the duplicate details before proceeding.');}const sheet=requireSheet_(HUB.SHEETS.SCRAPE);const row=firstEmptyInputRow_(sheet,2,Math.max(sheet.getMaxRows(),16000));const now=new Date();sheet.getRange(row,1).setValue(now);sheet.getRange(row,2).setValue(patient);if(uploadedFileUrl&&uploadedFileName&&!link){const rich=SpreadsheetApp.newRichTextValue().setText(uploadedFileName).setLinkUrl(uploadedFileUrl).build();sheet.getRange(row,3).setRichTextValue(rich);sheet.getRange(row,16).setValue(uploadedFileUrl);}else{sheet.getRange(row,3).setValue(link||uploadedFileUrl);}sheet.getRange(row,4).setValue(ninja);sheet.getRange(row,5).setValue(cleanText_(payload.uploadStatus)||'Uploaded');SpreadsheetApp.flush();audit_('ADD_SCRAPE',{row,patient,ninja,source:link||uploadedFileUrl,uploadedFileName});clearCache_(currentOperationalShiftDate_(now));return{ok:true,row,shiftDate:currentOperationalShiftDate_(now)};}
function uploadScrapePdf(filePayload){authorize_();if(!filePayload||!filePayload.base64||!filePayload.name)throw new Error('No PDF file was provided.');const name=cleanText_(filePayload.name);if(!/\.pdf$/i.test(name))throw new Error('Only PDF files can be uploaded.');const bytes=Utilities.base64Decode(String(filePayload.base64));if(bytes.length>HUB.MAX_PDF_BYTES)throw new Error('PDF is too large. Maximum upload size is 10 MB.');const folder=getOrCreatePdfFolder_();const blob=Utilities.newBlob(bytes,'application/pdf',name);const file=folder.createFile(blob);file.setDescription('Uploaded through 3Shape → ABS Operations Hub on '+Utilities.formatDate(new Date(),HUB.TZ,'yyyy-MM-dd HH:mm:ss'));audit_('UPLOAD_SCRAPE_PDF',{fileId:file.getId(),fileName:name});return{ok:true,fileId:file.getId(),fileName:name,fileUrl:file.getUrl()};}
function getOrCreatePdfFolder_(){const props=PropertiesService.getScriptProperties();const configured=props.getProperty(HUB.PROPERTY_PDF_FOLDER_ID);if(configured){try{return DriveApp.getFolderById(configured);}catch(e){}}const folder=DriveApp.createFolder('3Shape ABS Web Uploads');folder.setDescription('Private PDF uploads from the 3Shape → ABS Operations Hub. Share this folder only with authorized team members.');props.setProperty(HUB.PROPERTY_PDF_FOLDER_ID,folder.getId());audit_('CREATE_PDF_UPLOAD_FOLDER',{folderId:folder.getId(),folderName:folder.getName()});return folder;}
function checkCaseDuplicate(payload){authorize_();payload=payload||{};const sourceLink=cleanText_(payload.sourceLink);const fileName=cleanText_(payload.fileName);const patientName=cleanText_(payload.patientName);const linkKey=normalizedLinkKey_(sourceLink);const fileKey=normalizedFilenameKey_(fileName||filenameFromLink_(sourceLink));const baseFileKey=baseFilenameKey_(fileKey);const patientKey=normalizedPatientKey_(patientName||patientFromFilename_(fileName||filenameFromLink_(sourceLink)));if(!(linkKey||fileKey||patientKey))return{found:false,strongDuplicate:false,processedDuplicate:false,pendingMatch:false,possibleMatch:false,matches:[]};const scrapes=scrapeRows_();const outcomes=absOutcomeRows_();const candidates=[];scrapes.forEach(r=>{let score=0,matchType='';if(linkKey&&r.linkKey&&linkKey===r.linkKey){score=100;matchType='EXACT LINK';}else if(fileKey&&r.filenameKey&&fileKey===r.filenameKey){score=95;matchType='EXACT PDF FILE';}else if(baseFileKey&&r.filenameKey&&baseFileKey===baseFilenameKey_(r.filenameKey)){score=85;matchType='BASE PDF FILE';}else if(patientKey&&normalizedPatientKey_(r.patientName)===patientKey){score=60;matchType='PATIENT NAME';}if(!score)return;const related=outcomes.filter(o=>(r.trackerId&&o.trackerId===r.trackerId)||(linkKey&&o.linkKey&&o.linkKey===linkKey)||(fileKey&&o.filenameKey&&o.filenameKey===fileKey)||(r.filenameKey&&o.filenameKey&&r.filenameKey===o.filenameKey));related.sort((a,b)=>String(b.timestamp||'').localeCompare(String(a.timestamp||'')));const latest=related[0]||null;candidates.push({score,matchType,trackerId:r.trackerId,patientName:r.patientName,scrapeTimestamp:r.timestampDisplay,sourceLink:r.underlyingUrl||r.sourceLink,scrapedBy:r.scrapedBy,sourceShiftDate:r.shiftDate,disposition:latest?latest.disposition:'Pending',processedBy:latest?latest.ninja:'',absCaseId:latest?latest.absCaseId:'',escalationReason:latest?latest.escalationReason:'',outcomeNotes:latest?latest.outcomeNotes:'',absTimestamp:latest?latest.timestampDisplay:'',trackerMatchStatus:latest?latest.trackerMatchStatus:''});});candidates.sort((a,b)=>b.score-a.score||String(b.scrapeTimestamp||'').localeCompare(String(a.scrapeTimestamp||'')));const matches=candidates.slice(0,5);const strong=matches.filter(m=>m.score>=85);const processed=strong.filter(m=>m.disposition==='Completed'||m.disposition==='Escalated');const pending=strong.filter(m=>!(m.disposition==='Completed'||m.disposition==='Escalated'));return{found:matches.length>0,strongDuplicate:strong.length>0,processedDuplicate:processed.length>0,pendingMatch:pending.length>0,possibleMatch:matches.length>0&&strong.length===0,canProcess:processed.length===0,matches};}
function addAbsOutcome(payload){authorize_();if(!payload)throw new Error('Missing ABS payload.');const link=cleanText_(payload.pdfLink);const ninja=canonicalNinja_(payload.processedBy);const disposition=cleanText_(payload.disposition);const absCaseId=cleanText_(payload.absCaseId);const escalationReason=cleanText_(payload.escalationReason);const notes=cleanText_(payload.notes);if(!link)throw new Error('PDF link is required.');if(!ninja)throw new Error('Processed By is required.');if(!['Completed','Escalated'].includes(disposition))throw new Error('Disposition must be Completed or Escalated.');if(disposition==='Completed'&&!absCaseId)throw new Error('ABS Case ID is required for Completed cases.');if(disposition==='Escalated'&&!(escalationReason||notes))throw new Error('Escalation reason is required for Escalated cases.');const duplicate=checkCaseDuplicate({sourceLink:link});const processed=(duplicate.matches||[]).find(m=>m.score>=85&&(m.disposition==='Completed'||m.disposition==='Escalated'));if(processed){const detail=[processed.trackerId?'Tracker '+processed.trackerId:'',processed.disposition||'',processed.processedBy?'by '+processed.processedBy:'',processed.absCaseId?'ABS '+processed.absCaseId:''].filter(Boolean).join(' · ');const note=processed.escalationReason||processed.outcomeNotes||'';throw new Error('ALREADY PROCESSED — DO NOT PROCEED. '+detail+(note?' · Notes: '+note:''));}const lock=LockService.getScriptLock();lock.waitLock(10000);try{clearCache_();const secondCheck=checkCaseDuplicate({sourceLink:link});const secondProcessed=(secondCheck.matches||[]).find(m=>m.score>=85&&(m.disposition==='Completed'||m.disposition==='Escalated'));if(secondProcessed)throw new Error('ALREADY PROCESSED — another update was saved for this case. Refresh the match before proceeding.');const sheet=requireSheet_(HUB.SHEETS.ABS);const row=firstEmptyInputRow_(sheet,2,Math.max(sheet.getMaxRows(),16989));const now=new Date();sheet.getRange(row,1).setValue(now);sheet.getRange(row,3).setValue(link);sheet.getRange(row,6).setValue(ninja);sheet.getRange(row,7).setValue(disposition);sheet.getRange(row,8).setValue(absCaseId);sheet.getRange(row,9).setValue(escalationReason);sheet.getRange(row,13).setValue(notes);SpreadsheetApp.flush();audit_('ADD_ABS_OUTCOME',{row,ninja,disposition,absCaseId,link});clearCache_(currentOperationalShiftDate_(now));return{ok:true,row,shiftDate:currentOperationalShiftDate_(now)};}finally{lock.releaseLock();}}
function saveClearPathInputs(payload){authorize_();if(!payload)throw new Error('Missing ClearPath payload.');ensureWebSheets_();const shiftDate=normalizeShiftDate_(payload.shiftDate);if(!shiftDate)throw new Error('Shift Date is required.');const opening=nonNegativeNumber_(payload.openingQueue);const closing=nonNegativeNumber_(payload.closingQueue);const otherUploads=nonNegativeNumber_(payload.otherUploads);const sheet=requireSheet_(HUB.SHEETS.WEB_CONFIG);const values=sheet.getDataRange().getValues();let row=-1;for(let i=1;i<values.length;i++){if(dateKey_(values[i][0])===shiftDate){row=i+1;break;}}if(row<0)row=Math.max(sheet.getLastRow()+1,2);sheet.getRange(row,1,1,6).setValues([[parseDateKey_(shiftDate),opening,closing,otherUploads,new Date(),Session.getActiveUser().getEmail()||'']]);audit_('SAVE_CLEARPATH',{shiftDate,opening,closing,otherUploads});clearCache_();return buildClearPath_(shiftDate);}
function saveProductivityReason(payload){authorize_();if(!payload)throw new Error('Missing reason payload.');ensureWebSheets_();const shiftDate=normalizeShiftDate_(payload.shiftDate);const ninja=canonicalNinja_(payload.ninja);const interval=cleanText_(payload.interval);const reason=cleanText_(payload.reason);if(!shiftDate||!ninja||!interval)throw new Error('Shift Date, Ninja and interval are required.');let sheet=getSheet_(HUB.SHEETS.REASONS);if(!sheet){sheet=ss_().insertSheet(HUB.SHEETS.REASONS);sheet.getRange(1,1,1,5).setValues([['Shift Date','Ninja','Interval','Reason','Updated At']]);}const values=readRows_(sheet,Math.max(sheet.getLastColumn(),5));const headers=values.length?values[0].map(String):[];const dIdx=findHeaderIndex_(headers,['Shift Date']);const nIdx=findHeaderIndex_(headers,['Ninja','Processed By Ninja']);const iIdx=findHeaderIndex_(headers,['Interval','Hour Interval']);const rIdx=findHeaderIndex_(headers,['Reason','Productivity Miss Reason']);const uIdx=findHeaderIndex_(headers,['Updated At','Timestamp']);if([dIdx,nIdx,iIdx,rIdx].some(x=>x<0))throw new Error('Productivity Reason Store columns could not be identified.');let targetRow=-1;for(let r=1;r<values.length;r++){if(dateKey_(values[r][dIdx])===shiftDate&&String(values[r][nIdx]||'')===ninja&&String(values[r][iIdx]||'')===interval){targetRow=r+1;break;}}if(targetRow<0)targetRow=Math.max(sheet.getLastRow()+1,2);sheet.getRange(targetRow,dIdx+1).setValue(parseDateKey_(shiftDate));sheet.getRange(targetRow,nIdx+1).setValue(ninja);sheet.getRange(targetRow,iIdx+1).setValue(interval);sheet.getRange(targetRow,rIdx+1).setValue(reason);if(uIdx>=0)sheet.getRange(targetRow,uIdx+1).setValue(new Date());clearCache_();return{ok:true};}

function buildDashboard_(shiftDate){const key=normalizeShiftDate_(shiftDate);const rec=reconciliationRows_(key);let completed=0,escalated=0,pending=0;rec.forEach(r=>{if(r.absDisposition==='Completed')completed++;else if(r.absDisposition==='Escalated')escalated++;else pending++;});const total=rec.length;const reconciled=completed+escalated;const issues=rec.reduce((n,r)=>n+(r.qualityIssues.length?1:0),0);const ninjaTotals=buildNinjaOutcomeTotals_(key);const oldCarryover=buildCarryover_(key);return{shiftDate:key,coverage:shiftCoverageLabel_(key),totalScraped:total,completed,escalated,pending,reconciled,reconciliationRate:total?round2_(reconciled/total*100):0,dataQualityIssues:issues,eodResult:(pending===0&&issues===0)?'PASS':'ACTION NEEDED',ninjaTotals,carryover:oldCarryover,recent:rec.slice().sort((a,b)=>String(b.scrapeTimestamp).localeCompare(String(a.scrapeTimestamp))).slice(0,10)};}
function reconciliationRows_(shiftDate){const cache=CacheService.getScriptCache();const cKey='recon:'+shiftDate;const cached=cache.get(cKey);if(cached)return JSON.parse(cached);const sheet=requireSheet_(HUB.SHEETS.RECON);const rows=readRows_(sheet,15);const out=[];rows.slice(1).forEach(r=>{if(!r[0])return;const d=dateKey_(r[14]);if(d!==shiftDate)return;const disp=cleanText_(r[6])||'Pending';const reason=cleanText_(r[9]);const matchCount=Number(r[10]||0);const status=cleanText_(r[11]);const issues=[];if(disp==='Completed'&&!cleanText_(r[7]))issues.push('MISSING ABS CASE ID');if(disp==='Escalated'&&!reason)issues.push('MISSING ESCALATION REASON');if(matchCount>1)issues.push('MULTIPLE ABS UPDATES');out.push({trackerId:cleanText_(r[0]),patientName:cleanText_(r[1]),scrapeTimestamp:displayDateTime_(r[2]),sourceLink:cleanText_(r[3]),scrapedBy:cleanText_(r[4]),uploadStatus:cleanText_(r[5]),absDisposition:disp,absCaseId:cleanText_(r[7]),processedBy:cleanText_(r[8]),escalationReason:reason,absMatchCount:matchCount,reconciliationStatus:status,ageHours:Number(r[12]||0),eodAction:cleanText_(r[13]),shiftDate:d,qualityIssues:issues});});try{cache.put(cKey,JSON.stringify(out),HUB.CACHE_SECONDS);}catch(e){}return out;}
function buildNinjaOutcomeTotals_(shiftDate){const data=absOutcomeRows_().filter(r=>r.operationalShiftDate===shiftDate);const map={};HUB.NINJAS.forEach(n=>map[n]={ninja:n,completed:0,escalated:0,total:0});data.forEach(r=>{if(!map[r.ninja])return;if(r.disposition==='Completed')map[r.ninja].completed++;if(r.disposition==='Escalated')map[r.ninja].escalated++;if(['Completed','Escalated'].includes(r.disposition))map[r.ninja].total++;});return HUB.NINJAS.map(n=>map[n]);}
